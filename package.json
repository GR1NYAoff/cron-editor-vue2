{
  "name": "cron-editor-vue2",
  "version": "1.0.11",
  "repository": "https://github.com/GR1NYAoff/cron-editor-vue2",
  "author": "Gregory Tsyapa",
  "license": "MIT",
  "keywords": [
    "vue",
    "vue.js",
    "vue component",
    "cron",
    "cron expression",
    "crontab",
    "cron editor",
    "cronjob",
    "schedule"
  ],
  "private": false,
  "description": "cron editor component using basic cron syntax (5 digits)",
  "main": "dist/vue-cron-editor.ssr.js",
  "browser": "dist/vue-cron-editor.esm.js",
  "module": "dist/vue-cron-editor.esm.js",
  "unpkg": "dist/vue-cron-editor.min.js",
  "files": [
    "dist/*",
    "src/**/*.vue",
    "src/**/*.js"
  ],
  "sideEffects": false,
  "scripts": {
    "serve": "cross-env NODE_OPTIONS=--openssl-legacy-provider vue-cli-service serve dev/serve.js",
    "prebuild": "rimraf ./dist",
    "prepublishOnly": "npm test && npm run build",
    "build": "cross-env NODE_ENV=production rollup --config build/rollup.config.js",
    "build:ssr": "cross-env NODE_ENV=production rollup --config build/rollup.config.js --format cjs",
    "build:es": "cross-env NODE_ENV=production rollup --config build/rollup.config.js --format es",
    "build:unpkg": "cross-env NODE_ENV=production rollup --config build/rollup.config.js --format iife",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "element-ui": "^2.15.13",
    "vue": "^2.6.14"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@rollup/plugin-alias": "^3.1.2",
    "@rollup/plugin-babel": "^5.3.0",
    "@rollup/plugin-commonjs": "^14.0.0",
    "@rollup/plugin-node-resolve": "^9.0.0",
    "@rollup/plugin-replace": "^2.4.2",
    "@vue/cli-plugin-babel": "^4.5.13",
    "@vue/cli-service": "^4.5.13",
    "@vue/test-utils": "^1.3.6",
    "babel-core": "^7.0.0-bridge.0",
    "babel-jest": "^26.6.3",
    "cross-env": "^7.0.3",
    "jest": "^26.6.3",
    "minimist": "^1.2.5",
    "rimraf": "^3.0.2",
    "rollup": "^2.52.8",
    "rollup-plugin-terser": "^7.0.2",
    "rollup-plugin-vue": "^5.1.9",
    "vue-jest": "^3.0.7",
    "vue-template-compiler": "^2.6.14",
    "core-js": "^3.30.1"
  },
  "peerDependencies": {
    "vue": "^2.6.14"
  },
  "engines": {
    "node": ">=12"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "jsx",
      "json",
      "vue"
    ],
    "transform": {
      "^.+\\.vue$": "vue-jest",
      "^.+\\.jsx?$": "babel-jest"
    },
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testEnvironment": "jsdom",
    "setupFiles": [
      "<rootDir>/tests/unit/setup.js"
    ],
    "testMatch": [
      "**/tests/unit/**/*.spec.js"
    ]
  }
}
